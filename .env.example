# Copy to .env.local for local development. Never commit real values.

# Mount the eve agent (withEve). Without it the page says the interview is offline.
EVE_ENABLED=false
# Long random secret shared only by the Next.js routes and the eve channel.
EVE_SERVICE_TOKEN=
# Trusted origin serving the eve routes, including the port and base path
# Locally: http://localhost:3000/tools/hire-an-agent.
# On Vercel eve mounts at the domain root, so use the deployment domain only, e.g. https://hire-an-agent-two.vercel.app.
EVE_AGENT_ORIGIN=http://localhost:3000
# Vercel AI Gateway key used by the agent's model.
AI_GATEWAY_API_KEY=
# Long random secret for signing session cookies and share-card links.
HIRE_SIGNING_SECRET=
# Maximum interviews per day across all visitors.
HIRE_DAILY_SESSION_CAP=300
# Where "Hire this agent for real" sends people.
NEXT_PUBLIC_VARAHION_ASSESSMENT_URL=
# Upstash Redis (from the Vercel Marketplace). Unset in dev: an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The public site that proxies this tool, used for metadata and share links (e.g. https://varahion.com).
NEXT_PUBLIC_SITE_URL=
# Extra origins allowed to call the API: the site that proxies the tool (comma-separated).
HIRE_ALLOWED_ORIGINS=https://varahion.com,https://www.varahion.com
