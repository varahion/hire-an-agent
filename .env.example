# Copy to .env.local for local development. Never commit real values.

# Mount the eve agent (withEve). Without it the page says the interview is offline.
EVE_ENABLED=false
# Long random secret shared only by the Next.js routes and the eve channel.
EVE_SERVICE_TOKEN=
# Trusted origin serving the eve routes, including the port (e.g. http://localhost:3000).
EVE_AGENT_ORIGIN=http://localhost:3000
# Vercel AI Gateway key used by the agent's model.
AI_GATEWAY_API_KEY=
# Model id for the candidate agent (AI Gateway format).
HIRE_AGENT_MODEL=openai/gpt-6-luna
# Long random secret for signing session cookies and share-card links.
HIRE_SIGNING_SECRET=
# Maximum interviews per day across all visitors.
HIRE_DAILY_SESSION_CAP=300
# Where "Hire this agent for real" sends people.
NEXT_PUBLIC_VARAHION_ASSESSMENT_URL=
# Upstash Redis (from the Vercel Marketplace). Unset in dev: an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
